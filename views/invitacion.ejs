<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Boda de <%= invitation.novios %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..700;1,400..700&family=Montserrat:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    .font-serif { font-family: 'Playfair Display', serif; }
    .font-sans { font-family: 'Montserrat', sans-serif; }
    
    .textura-cartulina {
      background-color: <%= invitation.colorFondo %>;
      <% if (invitation.imagenFondo) { %>
        background-image: linear-gradient(rgba(255,255,255,0.88), rgba(255,255,255,0.88)), url('<%= invitation.imagenFondo %>');
        background-size: cover;
        background-position: center;
      <% } else if (invitation.textura) { %>
        background-image: radial-gradient(rgba(0,0,0,0.04) 1px, transparent 0);
        background-size: 4px 4px;
      <% } %>
    }

    .flip-box {
      background: #1c1917;
      color: #fff;
      padding: 6px 10px;
      border-radius: 6px;
      box-shadow: 0 4px 6px -1px rgba(0,0,0,0.2);
      font-weight: 700;
      letter-spacing: -1px;
    }
  </style>
</head>
<body class="<%= invitation.fuente %> textura-cartulina min-h-screen py-10 px-4" style="color: <%= invitation.colorTexto %>;">

  <% if (invitation.youtubeUrl) { 
     let ytId = invitation.youtubeUrl.includes('v=') ? invitation.youtubeUrl.split('v=')[1].substring(0,11) : invitation.youtubeUrl.slice(-11);
  %>
    <div style="display:none;">
      <iframe id="youtube-audio" width="0" height="0" src="https://www.youtube.com/embed/<%= ytId %>?autoplay=1&loop=1&playlist=<%= ytId %>" allow="autoplay"></iframe>
    </div>
    <button onclick="activarMusica()" class="fixed bottom-4 right-4 bg-stone-900 text-white px-4 py-2 rounded-full shadow-lg text-xs z-50 flex items-center gap-2 font-sans hover:bg-stone-800 transition">
      🎵 Activar Música
    </button>
    <script>
      function activarMusica() {
        let iframe = document.getElementById('youtube-audio');
        iframe.src = iframe.src;
        event.target.style.display = 'none';
      }
    </script>
  <% } %>

  <div class="max-w-xl mx-auto bg-white/95 backdrop-blur-md p-8 md:p-12 rounded-3xl shadow-2xl text-center border border-stone-200/80 relative">
    
    <div class="absolute top-4 right-4">
      <button onclick="toggleAdminModal()" class="text-xs uppercase tracking-widest text-stone-400 hover:text-stone-800 transition font-sans border border-stone-200 px-3 py-1 rounded-full">
        🔑 Admin
      </button>
    </div>

    <div id="adminModal" class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
      <div class="bg-white p-6 rounded-2xl max-w-sm w-full shadow-xl text-center font-sans">
        <h3 class="text-lg font-serif font-bold mb-3 text-stone-900">Acceso Administrador</h3>
        <p class="text-xs text-stone-500 mb-4">Ingresa el PIN de seguridad para gestionar las confirmaciones y mesas.</p>
        <form action="/boda/<%= invitation.slug %>/admin-login" method="POST" class="space-y-3">
          <input type="password" name="pin" maxlength="4" required placeholder="PIN (ej. 1234)" class="w-full p-2.5 border border-stone-300 rounded-lg text-center text-lg tracking-widest">
          <div class="flex gap-2">
            <button type="submit" class="w-full bg-stone-900 text-white py-2 rounded-lg text-sm hover:bg-stone-800 transition">Entrar</button>
            <button type="button" onclick="toggleAdminModal()" class="w-full bg-stone-100 text-stone-700 py-2 rounded-lg text-sm hover:bg-stone-200 transition">Cancelar</button>
          </div>
        </form>
      </div>
    </div>
    <script>
      function toggleAdminModal() {
        document.getElementById('adminModal').classList.toggle('hidden');
      }
    </script>

    <span class="text-xs uppercase tracking-widest opacity-60">Nuestra Boda</span>
    <h1 class="text-4xl md:text-6xl font-bold my-4"><%= invitation.novios %></h1>
    
    <% if (invitation.fecha) { %>
      <div class="my-6 flex justify-center items-center gap-2 font-sans text-xs">
        <div class="flex flex-col items-center"><span id="days" class="flip-box text-lg">00</span><span class="mt-1 opacity-50 uppercase text-[10px]">Días</span></div>
        <span class="text-lg font-bold opacity-30 pb-4">:</span>
        <div class="flex flex-col items-center"><span id="hours" class="flip-box text-lg">00</span><span class="mt-1 opacity-50 uppercase text-[10px]">Hrs</span></div>
        <span class="text-lg font-bold opacity-30 pb-4">:</span>
        <div class="flex flex-col items-center"><span id="minutes" class="flip-box text-lg">00</span><span class="mt-1 opacity-50 uppercase text-[10px]">Min</span></div>
        <span class="text-lg font-bold opacity-30 pb-4">:</span>
        <div class="flex flex-col items-center"><span id="seconds" class="flip-box text-lg">00</span><span class="mt-1 opacity-50 uppercase text-[10px]">Seg</span></div>
      </div>
      <script>
        const weddingDate = new Date("<%= invitation.fecha %>").getTime();
        setInterval(() => {
          const now = new Date().getTime();
          const diff = weddingDate - now;
          if (diff > 0) {
            document.getElementById('days').innerText = String(Math.floor(diff / (1000 * 60 * 60 * 24))).padStart(2, '0');
            document.getElementById('hours').innerText = String(Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60))).padStart(2, '0');
            document.getElementById('minutes').innerText = String(Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60))).padStart(2, '0');
            document.getElementById('seconds').innerText = String(Math.floor((diff % (1000 * 60)) / 1000)).padStart(2, '0');
          }
        }, 1000);
      </script>
    <% } %>

    <p class="italic opacity-80 mb-6 text-lg">"<%= invitation.mensaje %>"</p>
    
    <% if (invitation.fotos && invitation.fotos.length > 0) { %>
      <div class="my-6 grid grid-cols-2 gap-3">
        <% invitation.fotos.forEach(foto => { %>
          <img src="<%= foto.trim() %>" alt="Foto novios" class="rounded-xl object-cover h-40 w-full shadow-md">
        <% }) %>
      </div>
    <% } %>

    <hr class="my-6 opacity-20">

    <div class="my-6 space-y-3">
      <h3 class="text-xl font-semibold tracking-wide">Cuándo y Dónde</h3>
      <p>📅 <strong><%= invitation.fechaTexto %></strong></p>
      <p>📍 <strong><%= invitation.lugar %></strong></p>
      
      <% if (invitation.mapaUrl) { %>
        <div class="mt-4 rounded-xl overflow-hidden shadow-inner border border-stone-200">
          <iframe src="<%= invitation.mapaUrl.includes('src=') ? invitation.mapaUrl.match(/src="([^"]+)"/)[1] : invitation.mapaUrl %>" width="100%" height="220" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
        </div>
      <% } %>
    </div>

    <% if (invitation.menu) { %>
      <hr class="my-6 opacity-20">
      <div class="my-6 text-left bg-stone-50 p-6 rounded-2xl border border-stone-200">
        <h3 class="text-xl font-semibold text-center mb-2">🍽️ Menú del Evento</h3>
        <p class="text-sm opacity-90 whitespace-pre-line text-center"><%= invitation.menu %></p>
      </div>
    <% } %>

    <hr class="my-6 opacity-20">

    <div id="rsvp" class="mt-8 text-left bg-stone-50 p-6 rounded-2xl border border-stone-200">
      <h3 class="text-xl font-semibold text-center mb-4">Confirma tu Asistencia</h3>
      <form action="/boda/<%= invitation.slug %>/rsvp" method="POST" class="space-y-4 font-sans text-sm">
        <div>
          <label class="block text-xs uppercase tracking-wider opacity-60">Tu Nombre Completo</label>
          <input type="text" name="nombre" required class="w-full mt-1 p-2.5 bg-white border border-stone-300 rounded-lg">
        </div>
        <div>
          <label class="block text-xs uppercase tracking-wider opacity-60">Correo Electrónico</label>
          <input type="email" name="correo" required placeholder="tucorreo@email.com" class="w-full mt-1 p-2.5 bg-white border border-stone-300 rounded-lg">
        </div>
        <div>
          <label class="block text-xs uppercase tracking-wider opacity-60">¿Asistirás?</label>
          <select name="asistencia" class="w-full mt-1 p-2.5 bg-white border border-stone-300 rounded-lg">
            <option value="Sí, ahí estaré">Sí, ahí estaré</option>
            <option value="No podré asistir">No podré asistir</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs uppercase tracking-wider opacity-60">Pases / Acompañantes</label>
            <input type="number" name="personas" value="1" min="1" max="5" class="w-full mt-1 p-2.5 bg-white border border-stone-300 rounded-lg">
          </div>
          <div>
            <label class="block text-xs uppercase tracking-wider opacity-60">Opción de Menú</label>
            <input type="text" name="menuElegido" placeholder="Ej. Lomito" class="w-full mt-1 p-2.5 bg-white border border-stone-300 rounded-lg">
          </div>
        </div>
        <button type="submit" class="w-full bg-stone-900 text-white py-3 rounded-xl hover:bg-stone-800 transition font-medium">Enviar Confirmación</button>
      </form>
    </div>

    <div id="buzon" class="mt-8 text-left bg-stone-50 p-6 rounded-2xl border border-stone-200">
      <h3 class="text-xl font-semibold text-center mb-4">💌 Buzón de Deseos</h3>
      <form action="/boda/<%= invitation.slug %>/buzon" method="POST" class="space-y-3 font-sans text-sm mb-6">
        <input type="text" name="remitente" required placeholder="Tu nombre" class="w-full p-2.5 bg-white border border-stone-300 rounded-lg">
        <textarea name="texto" rows="2" required placeholder="Mensaje para los novios..." class="w-full p-2.5 bg-white border border-stone-300 rounded-lg"></textarea>
        <button type="submit" class="w-full bg-stone-800 text-white py-2 rounded-lg hover:bg-stone-700 transition">Enviar Mensaje</button>
      </form>
      <div class="space-y-3 max-h-48 overflow-y-auto">
        <% if (invitation.mensajesBuzon && invitation.mensajesBuzon.length > 0) { %>
          <% invitation.mensajesBuzon.forEach(msg => { %>
            <div class="bg-white p-3 rounded-xl border border-stone-200 text-xs font-sans">
              <strong class="text-stone-900"><%= msg.remitente %>:</strong>
              <p class="text-stone-600 mt-1">"<%= msg.texto %>"</p>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>

  </div>
</body>
</html>
