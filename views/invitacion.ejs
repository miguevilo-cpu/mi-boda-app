<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Boda de <%= invitation.novios %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..700;1,400..700&family=Cinzel:wght@600;700&family=Cormorant+Garamond:ital,wght@0,600;1,400&family=Great+Vibes&family=Alex+Brush&family=Pinyon+Script&family=Italianno&family=Bodoni+Moda:ital,wght@0,500;1,400&family=Montserrat:wght@300;400;500;600&family=Lato:wght@300;400;700&family=Raleway:wght@300;400;500&family=Lora:ital,wght@0,400;1,400&display=swap" rel="stylesheet">
  <style>
    .font-playfair { font-family: 'Playfair Display', serif; }
    .font-cinzel { font-family: 'Cinzel', serif; }
    .font-cormorant { font-family: 'Cormorant Garamond', serif; }
    .font-great-vibes { font-family: 'Great Vibes', cursive; }
    .font-alex-brush { font-family: 'Alex Brush', cursive; }
    .font-pinyon { font-family: 'Pinyon Script', cursive; }
    .font-italianno { font-family: 'Italianno', cursive; }
    .font-bodoni { font-family: 'Bodoni Moda', serif; }
    .font-montserrat { font-family: 'Montserrat', sans-serif; }
    .font-lato { font-family: 'Lato', sans-serif; }
    .font-raleway { font-family: 'Raleway', sans-serif; }
    .font-lora { font-family: 'Lora', serif; }

    .textura-cartulina-hilo {
      background-color: <%= invitation.colorFondo %>;
      <% if (invitation.imagenFondo && invitation.imagenFondo.length > 0) { %>
        background-image: linear-gradient(rgba(255,255,255,0.85), rgba(255,255,255,0.85)), url('<%= invitation.imagenFondo %>');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
      <% } else if (invitation.textura) { %>
        background-image: radial-gradient(rgba(0,0,0,0.05) 1px, transparent 0), url("data:image/svg+xml,%3Csvg width='24' height='24' viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0 0h24v24H0z' fill='none'/%3E%3Cpath d='M0 2h24M0 6h24M0 10h24M0 14h24M0 18h24M0 22h24M2 0v24M6 0v24M10 0v24M14 0v24M18 0v24M22 0v24' stroke='%23000000' stroke-opacity='0.04' stroke-width='0.7'/%3E%3C/svg%3E");
        background-size: 24px 24px;
      <% } %>
    }

    .doblez-hoja {
      position: relative;
      margin: 2.5rem 0;
      height: 1px;
      background: rgba(0, 0, 0, 0.08);
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06), 0 -1px 2px rgba(255, 255, 255, 0.9);
    }

    .flip-card {
      background-color: <%= invitation.colorTexto %>;
      color: <%= invitation.colorFondo %>;
      padding: 8px 12px;
      border-radius: 8px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.15);
      position: relative;
      overflow: hidden;
      display: inline-block;
      min-width: 44px;
      text-align: center;
    }
    .flip-anim {
      animation: flipDown 0.3s ease-in-out;
    }
    @keyframes flipDown {
      0% { transform: rotateX(0deg); opacity: 1; }
      50% { transform: rotateX(-90deg); opacity: 0.4; }
      100% { transform: rotateX(0deg); opacity: 1; }
    }

    .envelope-wrapper { perspective: 1400px; }
    .envelope-flap {
      transform-origin: top;
      transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .open-flap {
      transform: rotateX(180deg);
      z-index: 5 !important;
    }

    .wax-seal {
      background: radial-gradient(circle at 30% 30%, #881337, #4c0519);
      box-shadow: 0 8px 16px rgba(0,0,0,0.4), inset 0 2px 4px rgba(255,255,255,0.3);
      border: 2px solid #701a75;
      color: <%= invitation.colorFondo %>;
      text-shadow: 0 1px 2px rgba(0,0,0,0.5);
    }

    .fan-gallery {
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 260px;
      perspective: 1000px;
      padding: 20px 0;
    }
    .fan-card {
      width: 140px;
      height: 190px;
      object-fit: cover;
      border-radius: 16px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.2);
      transition: all 0.5s cubic-bezier(0.25, 1, 0.5, 1);
      position: absolute;
      cursor: pointer;
      border: 3px solid #ffffff;
    }
    .fan-card:nth-child(1) { transform: translateX(-60px) rotate(-12deg); z-index: 1; }
    .fan-card:nth-child(2) { transform: translateX(-20px) rotate(-4deg); z-index: 2; }
    .fan-card:nth-child(3) { transform: translateX(20px) rotate(4deg); z-index: 3; }
    .fan-card:nth-child(4) { transform: translateX(60px) rotate(12deg); z-index: 4; }

    .fan-gallery:hover .fan-card:nth-child(1) { transform: translateX(-110px) rotate(-18deg) scale(0.95); }
    .fan-gallery:hover .fan-card:nth-child(2) { transform: translateX(-40px) rotate(-6deg) scale(0.98); }
    .fan-gallery:hover .fan-card:nth-child(3) { transform: translateX(40px) rotate(6deg) scale(0.98); }
    .fan-gallery:hover .fan-card:nth-child(4) { transform: translateX(110px) rotate(18deg) scale(0.95); }

    .fan-card:hover {
      transform: translateY(-15px) scale(1.25) rotate(0deg) !important;
      z-index: 50 !important;
      box-shadow: 0 20px 40px rgba(0,0,0,0.4);
    }
  </style>
</head>
<body class="<%= invitation.fuenteSecundaria %> textura-cartulina-hilo min-h-screen py-10 px-4 select-none" style="color: <%= invitation.colorTexto %>;" data-wedding-date="<%= invitation.fecha %>">

  <% if (invitation.youtubeUrl) { 
     let ytId = invitation.youtubeUrl.includes('v=') ? invitation.youtubeUrl.split('v=')[1].substring(0,11) : invitation.youtubeUrl.slice(-11);
  %>
    <div style="display:none;">
      <iframe id="youtube-audio" width="0" height="0" src="" data-src="https://www.youtube.com/embed/<%= ytId %>?autoplay=1&loop=1&playlist=<%= ytId %>" allow="autoplay"></iframe>
    </div>
  <% } %>

  <% 
    let nombres = invitation.novios.split(/[&yY]/);
    let init1 = nombres[0] ? nombres[0].trim().charAt(0).toUpperCase() : 'M';
    let init2 = nombres[1] ? nombres[1].trim().charAt(0).toUpperCase() : 'M';
    let monograma = `${init1} & ${init2}`;
  %>

  <!-- Pantalla del Sobre con eventos directos de apertura -->
  <div id="envelope-screen" class="fixed inset-0 z-50 bg-stone-950 flex items-center justify-center p-4 cursor-pointer envelope-wrapper" onclick="abrirInvitacion()">
    <div class="relative w-[94vw] max-w-xl h-[460px] bg-stone-100 rounded-3xl shadow-2xl border border-stone-300 flex flex-col justify-between items-center p-8 text-center overflow-hidden pointer-events-none" id="envelope">
      
      <div id="flap" class="absolute top-0 left-0 w-full h-52 bg-stone-200 border-b border-stone-300 z-30 envelope-flap shadow-lg" style="clip-path: polygon(0 0, 100% 0, 50% 100%);">
      </div>

      <div id="seal" class="wax-seal absolute top-[175px] z-40 w-14 h-14 rounded-full flex items-center justify-center font-bold text-sm tracking-tighter shadow-2xl <%= invitation.fuentePrimaria %>">
        <%= monograma %>
      </div>

      <div class="pt-6 z-20">
        <span class="text-[10px] uppercase tracking-[0.3em] text-stone-400 font-sans font-semibold">NUESTRA BODA</span>
      </div>

      <div class="z-20 my-auto px-4 pt-10">
        <h2 class="text-xl md:text-3xl font-bold text-stone-900 leading-snug <%= invitation.fuentePrimaria %>"><%= invitation.novios %></h2>
      </div>

      <div class="pb-2 z-20">
        <p class="text-[11px] text-stone-600 font-sans italic bg-white/90 px-5 py-2 rounded-full shadow-sm inline-block border border-stone-200">✉️ Toca el sello para abrir</p>
      </div>

    </div>
  </div>

  <script>
    let sobreAbierto = false;
    function abrirInvitacion() {
      if (sobreAbierto) return;
      sobreAbierto = true;

      const flap = document.getElementById('flap');
      if (flap) flap.classList.add('open-flap');

      const iframe = document.getElementById('youtube-audio');
      if (iframe && iframe.getAttribute('data-src')) {
        iframe.src = iframe.getAttribute('data-src');
      }

      setTimeout(() => {
        const screen = document.getElementById('envelope-screen');
        if (screen) {
          screen.style.transition = 'opacity 0.7s ease, transform 0.7s ease';
          screen.style.opacity = '0';
          screen.style.transform = 'scale(1.05)';
          setTimeout(() => { screen.style.display = 'none'; }, 700);
        }
      }, 400);
    }
  </script>

  <div class="max-w-xl mx-auto bg-white/95 backdrop-blur-md p-8 md:p-14 rounded-3xl shadow-[0_25px_60px_-15px_rgba(0,0,0,0.15)] text-center border border-stone-300/80 relative">
    
    <div class="absolute top-4 right-4">
      <button onclick="toggleAdminModal()" class="text-[10px] uppercase tracking-widest text-stone-400 hover:text-stone-800 transition font-sans border border-stone-200 px-3 py-1 rounded-full cursor-pointer">
        🔑 Admin
      </button>
    </div>

    <div id="adminModal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
      <div class="bg-white p-6 rounded-2xl max-w-sm w-full shadow-2xl text-center font-sans">
        <h3 class="text-lg font-serif font-bold mb-2 text-stone-900">Acceso Administrador</h3>
        <p class="text-xs text-stone-500 mb-4">Ingresa el PIN de seguridad de tu boda:</p>
        <form action="/boda/<%= invitation.slug %>/admin-login" method="POST" class="space-y-3">
          <input type="password" name="pin" maxlength="4" required placeholder="PIN (ej. 1234)" class="w-full p-2.5 border border-stone-300 rounded-xl text-center text-lg tracking-widest">
          <div class="flex gap-2">
            <button type="submit" class="w-full bg-stone-900 text-white py-2 rounded-xl text-xs font-medium cursor-pointer">Ingresar</button>
            <button type="button" onclick="toggleAdminModal()" class="w-full bg-stone-100 text-stone-700 py-2 rounded-xl text-xs cursor-pointer">Cancelar</button>
          </div>
        </form>
      </div>
    </div>
    <script>
      function toggleAdminModal() {
        document.getElementById('adminModal').classList.toggle('hidden');
      }
    </script>

    <span class="text-xs uppercase tracking-widest opacity-60">Nos Casamos</span>
    <h1 class="text-4xl md:text-6xl font-bold my-3 <%= invitation.fuentePrimaria %>"><%= invitation.novios %></h1>
    
    <% if (invitation.fecha) { %>
      <div class="my-6 flex justify-center items-center gap-2 font-sans text-xs">
        <div class="flex flex-col items-center">
          <span id="days" class="flip-card text-xl font-bold">00</span>
          <span class="mt-1.5 opacity-50 uppercase text-[9px] tracking-wider">Días</span>
        </div>
        <span class="text-xl font-bold opacity-30 pb-4">:</span>
        <div class="flex flex-col items-center">
          <span id="hours" class="flip-card text-xl font-bold">00</span>
          <span class="mt-1.5 opacity-50 uppercase text-[9px] tracking-wider">Hrs</span>
        </div>
        <span class="text-xl font-bold opacity-30 pb-4">:</span>
        <div class="flex flex-col items-center">
          <span id="minutes" class="flip-card text-xl font-bold">00</span>
          <span class="mt-1.5 opacity-50 uppercase text-[9px] tracking-wider">Min</span>
        </div>
        <span class="text-xl font-bold opacity-30 pb-4">:</span>
        <div class="flex flex-col items-center">
          <span id="seconds" class="flip-card text-xl font-bold">00</span>
          <span class="mt-1.5 opacity-50 uppercase text-[9px] tracking-wider">Seg</span>
        </div>
      </div>
      <script>
        const weddingDateStr = document.body.getAttribute('data-wedding-date');
        const weddingDate = new Date(weddingDateStr).getTime();

        function updateValue(id, newValue) {
          const el = document.getElementById(id);
          if (el && el.innerText !== newValue) {
            el.innerText = newValue;
            el.classList.remove('flip-anim');
            void el.offsetWidth;
            el.classList.add('flip-anim');
          }
        }

        function actualizarReloj() {
          const now = new Date().getTime();
          const diff = weddingDate - now;
          if (diff > 0) {
            updateValue('days', String(Math.floor(diff / (1000 * 60 * 60 * 24))).padStart(2, '0'));
            updateValue('hours', String(Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60))).padStart(2, '0'));
            updateValue('minutes', String(Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60))).padStart(2, '0'));
            updateValue('seconds', String(Math.floor((diff % (1000 * 60)) / 1000)).padStart(2, '0'));
          }
        }
        setInterval(actualizarReloj, 1000);
        actualizarReloj();
      </script>
    <% } %>

    <p class="italic opacity-80 my-4 text-base md:text-lg">"<%= invitation.mensaje %>"</p>
    
    <% if (invitation.fotos && invitation.fotos.length > 0) { %>
      <div class="my-8">
        <h3 class="text-xs uppercase tracking-widest text-stone-400 font-semibold mb-4">Galería de Momentos</h3>
        <div class="fan-gallery">
          <% invitation.fotos.forEach((foto, index) => { %>
            <img src="<%= foto.trim() %>" alt="Foto novios" class="fan-card" onclick="abrirLightbox('<%= foto.trim() %>')">
          <% }) %>
        </div>
      </div>

      <div id="lightbox" class="hidden fixed inset-0 z-50 bg-stone-950/85 backdrop-blur-md flex items-center justify-center p-4 cursor-pointer" onclick="cerrarLightbox()">
        <img id="lightbox-img" src="" class="max-w-[92vw] max-h-[88vh] rounded-2xl shadow-2xl object-contain border-4 border-white transition-transform duration-300">
      </div>

      <script>
        function abrirLightbox(url) {
          const lb = document.getElementById('lightbox');
          const img = document.getElementById('lightbox-img');
          img.src = url;
          lb.classList.remove('hidden');
        }
        function cerrarLightbox() {
          document.getElementById('lightbox').classList.add('hidden');
        }
      </script>
    <% } %>

    <div class="doblez-hoja"></div>

    <div class="space-y-6">
      <h3 class="text-2xl font-bold tracking-wide">¿Dónde y Cuándo?</h3>
      <p class="text-sm font-semibold">📅 <%= invitation.fechaTexto %></p>

      <% if (invitation.lugarCeremonia) { %>
        <div class="bg-stone-50/80 p-5 rounded-2xl border border-stone-200/80 text-center font-sans">
          <span class="text-xs uppercase tracking-widest text-stone-400 font-semibold">Ceremonia Eucarística</span>
          <p class="text-base font-bold text-stone-800 mt-1">⛪ <%= invitation.lugarCeremonia %></p>
          <% if (invitation.mapaCeremoniaUrl) { %>
            <div class="mt-3 rounded-xl overflow-hidden shadow-sm border border-stone-200">
              <iframe src="<%= invitation.mapaCeremoniaUrl %>" width="100%" height="200" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
            </div>
          <% } %>
        </div>
      <% } %>

      <% if (invitation.lugarRecepcion) { %>
        <div class="bg-stone-50/80 p-5 rounded-2xl border border-stone-200/80 text-center font-sans">
          <span class="text-xs uppercase tracking-widest text-stone-400 font-semibold">Recepción & Fiesta</span>
          <p class="text-base font-bold text-stone-800 mt-1">🥂 <%= invitation.lugarRecepcion %></p>
          <% if (invitation.mapaRecepcionUrl) { %>
            <div class="mt-3 rounded-xl overflow-hidden shadow-sm border border-stone-200">
              <iframe src="<%= invitation.mapaRecepcionUrl %>" width="100%" height="200" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
            </div>
          <% } %>
        </div>
      <% } %>
    </div>

    <div class="doblez-hoja"></div>

    <div class="space-y-4 font-sans">
      <h3 class="text-2xl font-bold tracking-wide">Código de Vestimenta</h3>
      <div class="inline-block bg-stone-900 text-white px-6 py-2 rounded-full text-sm font-bold uppercase tracking-widest shadow-md">
        <%= invitation.dressCode %>
      </div>

      <div class="bg-stone-50/80 p-5 rounded-2xl border border-stone-200/80 mt-4 text-xs space-y-4">
        <p class="text-stone-700 font-semibold italic text-sm">Por favor, no uses estos colores</p>
        
        <div class="grid grid-cols-2 gap-4">
          <div class="flex flex-col items-center bg-white p-3 rounded-xl border border-stone-100">
            <span class="text-2xl mb-1 text-stone-700">👠</span>
            <span class="font-semibold text-stone-700 mb-2 text-[11px]">Mujeres</span>
            <div class="flex gap-2">
              <% invitation.coloresProhibidosDamas.forEach(col => { %>
                <div class="w-6 h-6 rounded-full border border-stone-300 shadow-sm relative" style="background-color: <%= col %>;">
                  <span class="absolute -top-1 -right-1 bg-rose-600 text-white rounded-full text-[8px] w-3 h-3 flex items-center justify-center font-bold">✕</span>
                </div>
              <% }) %>
            </div>
          </div>

          <div class="flex flex-col items-center bg-white p-3 rounded-xl border border-stone-100">
            <span class="text-2xl mb-1 text-stone-700">🎩</span>
            <span class="font-semibold text-stone-700 mb-2 text-[11px]">Hombres</span>
            <div class="flex gap-2">
              <% invitation.coloresProhibidosCaballeros.forEach(col => { %>
                <div class="w-6 h-6 rounded-full border border-stone-300 shadow-sm relative" style="background-color: <%= col %>;">
                  <span class="absolute -top-1 -right-1 bg-rose-600 text-white rounded-full text-[8px] w-3 h-3 flex items-center justify-center font-bold">✕</span>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="doblez-hoja"></div>

    <% if (invitation.zelleEmail || invitation.binancePayId || invitation.binanceWalletUsdt || invitation.pagoMovilBanco || invitation.mostrarBuzonFisico) { %>
      <div class="space-y-4 font-sans">
        <h3 class="text-2xl font-bold tracking-wide">Mesa de Regalos</h3>
        <p class="text-xs text-stone-500 italic">Tu presencia es nuestro mejor regalo. Si deseas realizarnos un presente económico:</p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-left">
          
          <% if (invitation.zelleEmail) { %>
            <div class="bg-purple-50/60 p-4 rounded-2xl border border-purple-200/80 relative flex flex-col justify-between">
              <div>
                <div class="flex items-center gap-2 mb-2">
                  <svg class="w-6 h-6 text-purple-700" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M19.5 3h-15A1.5 1.5 0 0 0 3 4.5v15A1.5 1.5 0 0 0 4.5 21h15a1.5 1.5 0 0 0 1.5-1.5v-15A1.5 1.5 0 0 0 19.5 3zm-3 13.5H7.5V15l6-6H7.5V7.5h9V9l-6 6h6v1.5z"/>
                  </svg>
                  <span class="font-bold text-xs text-purple-900 tracking-wider">ZELLE</span>
                </div>
                <p class="text-xs font-semibold text-stone-800"><%= invitation.zelleEmail %></p>
                <p class="text-[11px] text-stone-500"><%= invitation.zelleTitular %></p>
              </div>
              <button onclick="copiarTexto('<%= invitation.zelleEmail %>')" class="mt-3 text-[10px] bg-purple-700 hover:bg-purple-800 text-white font-medium px-3 py-1.5 rounded-lg transition self-start shadow-sm cursor-pointer">Copiar Correo</button>
            </div>
          <% } %>

          <% if (invitation.binancePayId || invitation.binanceWalletUsdt)
