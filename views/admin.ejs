<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Panel Admin - Boda de <%= invitation.novios %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-stone-50 text-stone-900 font-sans p-6">
  <div class="max-w-6xl mx-auto bg-white p-8 rounded-2xl shadow-xl border border-stone-200">
    <div class="flex justify-between items-center mb-6">
      <div>
        <span class="text-xs uppercase tracking-widest text-stone-400">Panel de Control</span>
        <h1 class="text-3xl font-serif font-bold">Invitados & Mesas: <%= invitation.novios %></h1>
      </div>
      <a href="/boda/<%= invitation.slug %>" class="text-sm bg-stone-100 hover:bg-stone-200 text-stone-800 px-4 py-2 rounded-lg transition">Ver Invitación Pública ↗</a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
      <div class="bg-stone-50 p-4 rounded-xl border border-stone-200 text-center">
        <p class="text-xs uppercase text-stone-500">Total Invitaciones Confirmadas</p>
        <p class="text-2xl font-bold font-serif"><%= invitation.rsvps.filter(r => r.asistencia.includes('Sí')).length %></p>
      </div>
      <div class="bg-stone-50 p-4 rounded-xl border border-stone-200 text-center">
        <p class="text-xs uppercase text-stone-500">Total Personas (Titulares + Acompañantes)</p>
        <p class="text-2xl font-bold font-serif">
          <%= invitation.rsvps.filter(r => r.asistencia.includes('Sí')).reduce((acc, curr) => acc + (curr.llevaAcompanante ? 2 : 1), 0) %>
        </p>
      </div>
    </div>

    <h2 class="text-xl font-serif font-semibold mb-4">Lista de Confirmaciones</h2>
    
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-stone-200 text-xs uppercase text-stone-500 bg-stone-50">
            <th class="p-3">Nombre</th>
            <th class="p-3">Correo</th>
            <th class="p-3">Estado</th>
            <th class="p-3">Acompañante</th>
            <th class="p-3">Menú</th>
            <th class="p-3">Mesa Asignada</th>
            <th class="p-3 text-right">Acción</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100 text-sm">
          <% if (invitation.rsvps.length === 0) { %>
            <tr>
              <td colspan="7" class="p-6 text-center text-stone-400 italic">Aún no hay confirmaciones registradas.</td>
            </tr>
          <% } else { %>
            <% invitation.rsvps.forEach(rsvp => { %>
              <tr>
                <td class="p-3 font-medium"><%= rsvp.nombre %></td>
                <td class="p-3 text-stone-500 text-xs"><%= rsvp.correo %></td>
                <td class="p-3">
                  <span class="px-2 py-1 rounded-full text-xs <%= rsvp.asistencia.includes('Sí') ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800' %>">
                    <%= rsvp.asistencia %>
                  </span>
                </td>
                <td class="p-3"><%= rsvp.llevaAcompanante ? 'Sí (1)' : 'No' %></td>
                <td class="p-3 text-xs italic"><%= rsvp.menuElegido || 'N/A' %></td>
                <form action="/boda/<%= invitation.slug %>/admin/mesa?auth=ok" method="POST">
                  <input type="hidden" name="rsvpId" value="<%= rsvp._id %>">
                  <td class="p-3">
                    <input type="text" name="mesa" value="<%= rsvp.mesa %>" class="p-1.5 border border-stone-300 rounded text-xs w-28 bg-white">
                  </td>
                  <td class="p-3 text-right">
                    <button type="submit" class="bg-stone-900 text-white px-3 py-1.5 rounded text-xs hover:bg-stone-800 transition">Guardar</button>
                  </td>
                </form>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
  <footer class="mt-8 text-center text-xs text-stone-400">
    Nupcias © <%= new Date().getFullYear() %> Todos los derechos reservados
  </footer>
</body>
</html>
