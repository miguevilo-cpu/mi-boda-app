<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Crear Invitación Avanzada</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-stone-50 py-12 px-4 font-sans">
  <div class="max-w-2xl mx-auto bg-white p-8 rounded-2xl shadow-xl border border-stone-200">
    <h2 class="text-3xl font-serif mb-6 text-center">Diseña tu Boda Perfecta</h2>
    <form action="/crear" method="POST" class="space-y-6">
      
      <!-- Información General -->
      <div class="space-y-4">
        <h3 class="text-lg font-semibold border-b pb-2 text-stone-700">1. Información y Cuenta Regresiva</h3>
        <div>
          <label class="block text-sm font-medium text-stone-700">Nombres de los Novios</label>
          <input type="text" name="novios" required placeholder="Sofía & Alejandro" class="mt-1 w-full p-2.5 border rounded-lg">
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-stone-700">Fecha y Hora (Para Cuenta Regresiva)</label>
            <input type="datetime-local" name="fecha" required class="mt-1 w-full p-2.5 border rounded-lg text-sm">
          </div>
          <div>
            <label class="block text-sm font-medium text-stone-700">Texto Visible de la Fecha</label>
            <input type="text" name="fechaTexto" placeholder="15 de Octubre, 2026 - 5:00 PM" class="mt-1 w-full p-2.5 border rounded-lg">
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-stone-700">Lugar del Evento</label>
          <input type="text" name="lugar" required placeholder="Hacienda San José, Táchira" class="mt-1 w-full p-2.5 border rounded-lg">
        </div>
        <div>
          <label class="block text-sm font-medium text-stone-700">Enlace o Código Iframe de Google Maps</label>
          <input type="text" name="mapaUrl" placeholder="https://www.google.com/maps/embed?pb=..." class="mt-1 w-full p-2.5 border rounded-lg text-sm">
        </div>
        <div>
          <label class="block text-sm font-medium text-stone-700">PIN de Administrador (4 dígitos)</label>
          <input type="password" name="pinAdmin" value="1234" maxlength="4" required class="mt-1 w-full p-2.5 border rounded-lg text-sm">
        </div>
        <div>
          <label class="block text-sm font-medium text-stone-700">Mensaje de Bienvenida</label>
          <textarea name="mensaje" rows="3" class="mt-1 w-full p-2.5 border rounded-lg" placeholder="Nos emociona mucho compartir este gran día..."></textarea>
        </div>
      </div>

      <!-- Música y Estética -->
      <div class="space-y-4">
        <h3 class="text-lg font-semibold border-b pb-2 text-stone-700">2. Música de YouTube y Estilo Visual</h3>
        <div>
          <label class="block text-sm font-medium text-stone-700">Enlace de Canción de YouTube</label>
          <input type="text" name="youtubeUrl" placeholder="https://www.youtube.com/watch?v=TuIDDeVideo" class="mt-1 w-full p-2.5 border rounded-lg text-sm">
        </div>
        <div>
          <label class="block text-sm font-medium text-stone-700">URL de Imagen de Fondo (Opcional)</label>
          <input type="text" name="imagenFondo" placeholder="https://ejemplo.com/fondo.jpg" class="mt-1 w-full p-2.5 border rounded-lg text-sm">
        </div>
        <div class="flex items-center gap-2">
          <input type="checkbox" name="textura" id="textura" checked class="w-4 h-4 rounded text-stone-900">
          <label for="textura" class="text-sm font-medium text-stone-700">Activar textura de cartulina de hilo</label>
        </div>
        <div>
          <label class="block text-sm font-medium text-stone-700">Detalles del Menú</label>
          <textarea name="menu" rows="2" class="mt-1 w-full p-2.5 border rounded-lg" placeholder="Entrada, plato fuerte..."></textarea>
        </div>
        <div>
          <label class="block text-sm font-medium text-stone-700">Fotos de los Novios (URLs separadas por comas)</label>
          <input type="text" name="fotos" placeholder="https://img1.jpg, https://img2.jpg" class="mt-1 w-full p-2.5 border rounded-lg text-sm">
        </div>
      </div>

      <!-- Personalización Colores y Fuentes -->
      <div class="space-y-4">
        <h3 class="text-lg font-semibold border-b pb-2 text-stone-700">3. Tipografía y Colores</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <label class="block text-sm font-medium text-stone-700">Tipografía</label>
            <select name="fuente" class="mt-1 w-full p-2.5 border rounded-lg text-sm">
              <option value="font-serif">Clásica Elegante</option>
              <option value="font-sans">Moderna Minimalista</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-stone-700">Color de Texto</label>
            <input type="color" name="colorTexto" value="#1c1917" class="mt-1 w-full h-10 p-1 border rounded-lg cursor-pointer">
          </div>
          <div>
            <label class="block text-sm font-medium text-stone-700">Color de Fondo Base</label>
            <input type="color" name="colorFondo" value="#fafaf9" class="mt-1 w-full h-10 p-1 border rounded-lg cursor-pointer">
          </div>
        </div>
      </div>

      <button type="submit" class="w-full bg-stone-900 text-white py-3 rounded-xl hover:bg-stone-800 transition font-medium text-lg">Crear Invitación</button>
    </form>
  </div>
</body>
</html>
