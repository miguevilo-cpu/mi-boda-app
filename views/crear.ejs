<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Crear Invitación Avanzada</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..700;1,400..700&family=Montserrat:wght@300;400;500&family=Great+Vibes&display=swap" rel="stylesheet">
</head>
<body class="bg-stone-50 py-12 px-4">
  <div class="max-w-2xl mx-auto bg-white p-8 rounded-2xl shadow-xl border border-stone-200">
    <h2 class="text-3xl font-serif mb-6 text-center">Diseña tu Boda Perfecta</h2>
    <form action="/crear" method="POST" class="space-y-6">
      
      <!-- Datos Principales -->
      <div class="space-y-4">
        <h3 class="text-lg font-semibold border-b pb-2 text-stone-700">1. Información General</h3>
        <div>
          <label class="block text-sm font-medium text-stone-700">Nombres de los Novios</label>
          <input type="text" name="novios" required placeholder="Sofía & Alejandro" class="mt-1 w-full p-2.5 border rounded-lg">
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-stone-700">Fecha y Hora</label>
            <input type="text" name="fecha" required placeholder="15 de Octubre, 2026 - 5:00 PM" class="mt-1 w-full p-2.5 border rounded-lg">
          </div>
          <div>
            <label class="block text-sm font-medium text-stone-700">Lugar del Evento</label>
            <input type="text" name="lugar" required placeholder="Hacienda San José, Táchira" class="mt-1 w-full p-2.5 border rounded-lg">
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-stone-700">Enlace o Código Iframe de Google Maps</label>
          <input type="text" name="mapaUrl" placeholder="https://maps.google.com/..." class="mt-1 w-full p-2.5 border rounded-lg text-sm">
        </div>
        <div>
          <label class="block text-sm font-medium text-stone-700">Mensaje de Bienvenida / Historia</label>
          <textarea name="mensaje" rows="3" class="mt-1 w-full p-2.5 border rounded-lg" placeholder="Nos emociona mucho compartir este gran día..."></textarea>
        </div>
      </div>

      <!-- Multimedia y Extras -->
      <div class="space-y-4">
        <h3 class="text-lg font-semibold border-b pb-2 text-stone-700">2. Multimedia y Detalles</h3>
        <div>
          <label class="block text-sm font-medium text-stone-700">Enlace de Música de Fondo (URL de audio MP3)</label>
          <input type="text" name="musicaUrl" placeholder="https://ejemplo.com/cancion.mp3" class="mt-1 w-full p-2.5 border rounded-lg text-sm">
        </div>
        <div>
          <label class="block text-sm font-medium text-stone-700">Detalles del Menú (Opciones de comida)</label>
          <textarea name="menu" rows="2" class="mt-1 w-full p-2.5 border rounded-lg" placeholder="Entrada: Crema de zapallo | Plato fuerte: Lomito en reducción de vino o Pollo en salsa cítrica"></textarea>
        </div>
        <div>
          <label class="block text-sm font-medium text-stone-700">Fotos de los Novios (URLs separadas por comas)</label>
          <input type="text" name="fotos" placeholder="https://img1.jpg, https://img2.jpg" class="mt-1 w-full p-2.5 border rounded-lg text-sm">
        </div>
      </div>

      <!-- Personalización Visual -->
      <div class="space-y-4">
        <h3 class="text-lg font-semibold border-b pb-2 text-stone-700">3. Estilo y Tipografía</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <label class="block text-sm font-medium text-stone-700">Tipografía recomendada</label>
            <select name="fuente" class="mt-1 w-full p-2.5 border rounded-lg text-sm">
              <option value="font-serif">Clásica Elegante (Playfair)</option>
              <option value="font-sans">Moderna Minimalista (Montserrat)</option>
              <option value="font-cursive">Romántica (Cursive)</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-stone-700">Color de Texto</label>
            <input type="color" name="colorTexto" value="#1c1917" class="mt-1 w-full h-10 p-1 border rounded-lg cursor-pointer">
          </div>
          <div>
            <label class="block text-sm font-medium text-stone-700">Color de Fondo</label>
            <input type="color" name="colorFondo" value="#fafaf9" class="mt-1 w-full h-10 p-1 border rounded-lg cursor-pointer">
          </div>
        </div>
      </div>

      <button type="submit" class="w-full bg-stone-900 text-white py-3 rounded-xl hover:bg-stone-800 transition font-medium text-lg">Crear Invitación Interactiva</button>
    </form>
  </div>
</body>
</html>
